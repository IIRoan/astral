#!/usr/bin/env bash

set -xeuo pipefail

find "${SRCDIR}/cache/ublue-brew" -type f -exec setfattr -h -n user.component -v "homebrew" {} +
find "${SRCDIR}/cache/ublue-brew" -type f -exec setfattr -h -n user.update-interval -v "weekly" {} +

cp -a "${SRCDIR}/cache/ublue-brew/." /

stat /usr/lib/systemd/system/brew-setup.service
stat /usr/share/homebrew.tar.zst
test -x /usr/libexec/astral/brew-locked
test -x /usr/libexec/astral/install-brew-lock
stat /usr/lib/systemd/system/astral-brew-lock.service
stat /usr/lib/systemd/system/brew-update.service.d/50-astral-brew-proxy.conf
stat /usr/lib/systemd/system/brew-upgrade.service.d/50-astral-brew-proxy.conf
