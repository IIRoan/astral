[Unit]
Description=Create disk-backed swapfile
Documentation=https://github.com/iiroan/astral
DefaultDependencies=no
ConditionPathExists=!/var/swapfile
ConditionVirtualization=!container
# Waiting for all local filesystems creates a cycle through tmp.mount and
# swap.target. Only /var must be mounted before creating the swapfile.
RequiresMountsFor=/var
Before=var-swapfile.swap swap.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/astral/setup-swapfile

[Install]
WantedBy=swap.target
