#!/usr/bin/env bash

set -euo pipefail

# Use the image release, independently of the pinned build-tools release.
fedora_release="${RELEASE:?mkosi must provide the target Fedora release}"
if [[ "$fedora_release" = rawhide ]]; then
    fedora_release="$(rpm -E %fedora)"
fi
[[ "$fedora_release" =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid target Fedora release for OGC kernel' >&2; exit 1; }

mkdir -p "${SRCDIR}/cache"
"${SRCDIR}/build-scripts/ensure-tool" oras
"${SRCDIR}/build-scripts/ensure-tool" cosign

work="$(mktemp -d "${SRCDIR}/cache/.jackrabbit.XXXXXX")"
trap 'rm -rf "$work"' EXIT

image=ghcr.io/opengamingcollective/kernel-packages-fedora
digest="$("${SRCDIR}/cache/oras" resolve "$image:latest-fc${fedora_release}")"
[[ "$digest" =~ ^sha256:[a-f0-9]{64}$ ]] || { echo 'Invalid OGC kernel image digest' >&2; exit 1; }
reference="$image@$digest"
"${SRCDIR}/cache/cosign" verify \
    --certificate-identity-regexp '^https://github\.com/OpenGamingCollective/kernel-packages/\.github/workflows/fedora\.yaml@refs/tags/[^/]+$' \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com \
    "$reference" > /dev/null
"${SRCDIR}/cache/oras" pull --output "$work/kernel" "$reference"
compgen -G "$work/kernel/*.rpm" > /dev/null

curl --fail --show-error --silent --location --retry 3 \
    --proto '=https' --proto-redir '=https' \
    https://steamdeck-packages.steamos.cloud/archlinux-mirror/jupiter-main/os/x86_64/steamdeck-dsp-1.03-1-any.pkg.tar.zst \
    --output "$work/valve-audio.tar.zst"
printf '%s  %s\n' 1dc7c303a5503931b97bbeec44d5664d34f8cfe62050faa6992da5b005d72ae2 \
    "$work/valve-audio.tar.zst" | sha256sum --check --strict -
tar --zstd -xf "$work/valve-audio.tar.zst" -C "$work" --no-same-owner --no-same-permissions \
    usr/lib/firmware/amd usr/share/alsa/ucm2/conf.d
mkdir "$work/valve-audio"
mv "$work/usr/lib/firmware/amd" "$work/valve-audio/sof_fw"
mv "$work/usr/share/alsa/ucm2/conf.d/sof-nau8821-max" "$work/valve-audio/"

# Publish caches only after every input has passed verification.
rm -rf "${SRCDIR}/cache/linux-ogc" "${SRCDIR}/cache/valve-audio"
mv "$work/kernel" "${SRCDIR}/cache/linux-ogc"
mv "$work/valve-audio" "${SRCDIR}/cache/valve-audio"
