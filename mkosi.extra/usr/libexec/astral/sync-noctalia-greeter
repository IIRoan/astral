#!/usr/bin/env bash
set -euo pipefail

# Noctalia owns staging, protocol negotiation, and the privileged apply step.
# Wait for its IPC instead of racing a second, legacy helper invocation against it.
for _ in $(seq 1 45); do
  if noctalia msg greeter-sync >/dev/null 2>&1; then
    exit 0
  fi
  sleep 1
done

echo "Noctalia did not accept the greeter sync request within 45 seconds" >&2
exit 1
