#!/usr/bin/bash
set -euo pipefail

# The GUI needs a writable settings file. Keep image defaults in an import so
# later image updates can improve them without replacing personal settings.
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/vicinae"
settings="${config_dir}/settings.json"
if [[ ! -e "$settings" && ! -L "$settings" ]]; then
    mkdir -p "$config_dir"
    printf '%s\n' '{"imports":["/usr/share/astral/vicinae-defaults.json"]}' > "$settings"
fi
