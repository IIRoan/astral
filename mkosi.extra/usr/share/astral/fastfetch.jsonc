{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/astral/astral.txt",
        "color": {
            "1": "#8c90a3",
            "2": "default",
            "3": "#6ec8d6",
            "4": "#b1dcdc",
            "5": "#f4f0e2",
            "6": "#ebd3a6",
            "7": "#e2b56a"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#6ec8d6"
        },
    },
    "modules": [
        {
            "type": "title",
            "key": " ",
            "color": {
                "user": "#6ec8d6",
                "at": "white",
                "host": "#e2b56a"
            }
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "format": "{pretty-name}"
        },
        {
            "type": "command",
            "key": " ",
            "text": "echo Based on $(sed 's/release //;s/ ([^)]*)//' /usr/lib/system-release)",
            "shell": "/bin/bash"
        },
        {
            "type": "kernel",
            "key": " ",
            "format": "{1} {2}"
        },
        {
            "type": "uptime",
            "key": " 󰅐"
        },
        "break",
        {
          "type": "command",
          "key": " 󰔠",
          "text": "date -d$(ls -alct /var/log --time-style=full-iso|tail -1|awk '{print $6}') +'Forged on %b %d %G'",
          "shell": "/bin/bash"
        },
        {
            "type": "host",
            "key": " 󰾰"
        },
        {
            "type": "cpu",
            "key": " 󰻠"
        },
        {
            "type": "gpu",
            "key": " 󰍛"
        },
        {
            "type": "memory",
            "key": " "
        },
        {
            "type": "disk",
            "key": " ",
            "hideFS": "overlay:erofs"
        },
        {
            "type": "display",
            "key": " 󰍹"
        },
        {
            "type": "battery",
            "key": " "
        },
        {
            "type": "gamepad",
            "key": " 󰖺"
        },
        "break",
        {
            "type": "de",
            "key": " 󰕮"
        },
        {
            "type": "wm",
            "key": " "
        },
        {
            "type": "shell",
            "key": " "
        },
        {
            "type": "terminal",
            "key": " "
        },
        {
            "type": "packages",
            "key": " 󰏖",
            "disabled": ["rpm", "appimage"]
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
