// This is the entrypoint for Astral's Niri and Noctalia defaults.
// Read the Niri and Noctalia documentation for more information.
// https://yalter.github.io/niri/
// https://docs.noctalia.dev/noctalia/

//  DO NOT EDIT THIS FILE! Changes will be overwritten if you run chezmoi.
//  Instead, write your overrides in ~/.config/niri/local.kdl or /etc/niri/local.kdl
//  If you don't plan on running chezmoi, you can disregard this warning.

// include top-level settings from the system-wide default config
include "/usr/share/astral/dotfiles/system/niri/astral.kdl"

// include local user overrides
include optional=true "local.kdl"
