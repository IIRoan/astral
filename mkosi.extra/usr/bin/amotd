#!/usr/bin/env bash
if test ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/astral/no-show-user-motd" ; then
  reset=$'\e[0m'
  # bold=$'\e[1m'
  # link=$'\e[38;2;23;118;122m'
  # Logo colors: teal #6ec8d6 commands, dark text on gold #e2b56a header.
  cmd=$'\e[48;2;48;48;48m\e[38;2;110;200;214m'
  header=$'\e[1;38;2;20;27;45m\e[48;2;226;181;106m'
  # PLEASE make sure this is properly organized, i dont want to include glow on the image :steamsad:
  cat <<EOF

  ${header} Welcome to Astral! ${reset}

     Command                        │ Description
  ───────────────────────────────────┼────────────────────────────────────
    ${cmd} ajust status ${reset}                  │ Show image, policy, and container status
    ${cmd} ajust verify-image ${reset}            │ Confirm the local image signature policy
    ${cmd} ajust update ${reset}                   │ Manually update the system
    ${cmd} ajust update-dotfiles ${reset}          │ Update your unmodified dotfiles
    ${cmd} ajust update-greeter ${reset}           │ Sync the greeter from this user
    ${cmd} ajust toggle-user-motd ${reset}         │ Toggle this banner on/off

EOF
fi
