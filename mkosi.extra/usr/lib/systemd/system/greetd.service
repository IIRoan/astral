[Unit]
Description=Greeter daemon
# Keep Plymouth alive until the greeter claims DRM (do not wait for quit-wait).
After=systemd-user-sessions.service
After=getty@tty1.service
After=plymouth-quit.service
After=kmsconvt@tty1.service
Conflicts=getty@tty1.service
Conflicts=plymouth-quit.service
Conflicts=kmsconvt@tty1.service

[Service]
Type=simple
ExecStartPre=/usr/libexec/astral/prepare-greetd-vt hide
ExecStart=greetd
ExecStartPost=/usr/libexec/astral/prepare-greetd-vt retain
ExecStopPost=/usr/libexec/astral/prepare-greetd-vt show
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1
StartLimitBurst=5
StartLimitInterval=30

[Install]
Alias=display-manager.service
