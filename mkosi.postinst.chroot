#!/bin/bash
set -xeuo pipefail

/usr/libexec/astral/display-color --help

install -Dpm0644 -t /usr/share/flatpak/remotes.d/ "$SRCDIR/cache/flathub.flatpakrepo"

niri --version | grep -i -E "niri [[:digit:]]*\.[[:digit:]]*"
# Satellite 0.8.2 steals focus from Steam/Wine override-redirect popups.
satellite_version="$(rpm -q --qf '%{VERSION}' xwayland-satellite)"
rpm --define "astral_satellite_version $satellite_version" --eval \
    '%{lua:if rpm.vercmp(rpm.expand("%{astral_satellite_version}"), "0.8.3") < 0 then error("Xwayland Satellite 0.8.3 or newer is required") end}'
niri validate --config /usr/share/factory/etc/niri/config.kdl
noctalia-greeter sessions | grep -Fqx Niri
stat /usr/libexec/astral/noctalia-greeter-guard
stat /usr/libexec/astral/firmware-update-check
test -x /usr/libexec/astral/update-health
test -x /usr/libexec/astral/update-user-setup
test -x /usr/libexec/astral/composefs-remount
# thermald's RAPL controller overrides the per-mode power limits in astral-* TuneD profiles.
test ! -e /usr/lib/systemd/system/thermald.service
# Ship the regular vendor configuration so OSTree can merge later defaults
# with local changes. The preparation service also migrates Fedora 44 links.
install -Dpm0644 /usr/share/astral/tuned/ppd.conf /etc/tuned/ppd.conf
test -x /usr/libexec/astral/prepare-tuned-ppd
grep -Fx 'L+ /etc/greetd/config.toml' /usr/lib/tmpfiles.d/99-astral-factory.conf
grep -Fx 'C+ /var/lib/noctalia-greeter/greeter.toml 0640 greeter greeter - /usr/share/astral/noctalia-greeter.toml' /usr/lib/tmpfiles.d/99-astral-factory.conf
grep -Fx 'ConditionFileIsExecutable=/usr/bin/noctalia' /usr/lib/systemd/user/astral-sync-noctalia-greeter.service
grep -Fx 'ExecStartPre=/usr/libexec/astral/prepare-greetd-vt hide' /usr/lib/systemd/system/greetd.service.d/20-kmscon.conf
grep -Fq 'noctalia msg greeter-sync' /usr/libexec/astral/sync-noctalia-greeter
noctalia-greeter-apply-appearance --supports secure-sync-v1 | grep -Fx secure-sync-v1
python3 - <<'PY'
import xml.etree.ElementTree as ET

policy = ET.parse('/usr/share/polkit-1/actions/org.noctalia.greeter.apply-appearance.policy')
action = policy.find(".//action[@id='org.noctalia.greeter.sync-appearance']")
assert action is not None, 'Missing constrained appearance-sync action'
assert action.findtext("annotate[@key='org.freedesktop.policykit.exec.path']") == '/usr/bin/noctalia-greeter-apply-appearance'
assert action.findtext("annotate[@key='org.freedesktop.policykit.exec.argv1']") == '--sync'
PY
# Noctalia stores the same kind of greeter state as greetd. Ship the mapping in
# the image policy; tmpfiles relabels the persistent state after an image update.
semanage fcontext -a -t xdm_var_lib_t '/var/lib/noctalia-greeter(/.*)?'
if grep -Fq 'theme_mode' /usr/share/astral/noctalia-greeter.toml; then
    exit 1
fi
test -x /usr/libexec/astral/prepare-greetd-vt
command -v setterm
command -v pkexec

install -d /usr/share/astral/
# Fedora 45 ships vendor PAM configuration in /usr/lib/pam.d. The bootc
# profile removes any greeter package's /etc copy so it cannot shadow this.
sed --sandbox -i -e '/gnome_keyring.so/ s/-auth/auth/ ; /gnome_keyring.so/ s/-session/session/' /usr/lib/pam.d/greetd
# geoclue's demo agent only exists for desktops without their own agent prompt; with no agent geoclue still serves configured apps
rm -f /etc/xdg/autostart/geoclue-demo-agent.desktop
install -d /usr/share/bash-completion/completions /usr/share/zsh/site-functions /usr/share/fish/vendor_completions.d/
just --completions bash | sed -E 's/([\(_" ])just/\1ajust/g' > /usr/share/bash-completion/completions/ajust
just --completions zsh | sed -E 's/([\(_" ])just/\1ajust/g' > /usr/share/zsh/site-functions/_ajust
just --completions fish | sed -E 's/([\(_" ])just/\1ajust/g' > /usr/share/fish/vendor_completions.d/ajust.fish

fc-cache --force --really-force --system-only --verbose # recreate font-cache to pick up the added fonts

# These files NEED to be on the image.
grep -F -e "Comment=Central repository of Flatpak applications" /usr/share/flatpak/remotes.d/flathub.flatpakrepo
stat /usr/share/flatpak/remotes.d/flathub.flatpakrepo
stat /usr/bin/luks*tpm*
stat /usr/share/astral/just/00-start.just
stat /usr/share/zirconium/zdots/system/niri/zirconium.kdl
# Not yet, needs a lot of fixes for sysupdate version
# stat /usr/bin/taidan
# stat /usr/lib/systemd/system/taidan*.service

ln -s fedora-release /usr/lib/system-release


(
    . /usr/lib/os-release
    IMAGE_NAME="astral"
    HOME_URL="https://github.com/iiroan/astral"
    GOLD="226:181:106"

    tee /usr/lib/os-release <<EOF
NAME="${IMAGE_NAME^}"
ID="$ID"
ID_LIKE="${ID_LIKE:-$ID}"
VARIANT="${IMAGE_NAME^}"
VARIANT_ID="${IMAGE_NAME}"
PRETTY_NAME="${IMAGE_NAME^}"
FANCY_NAME="\033[0;38:2:${GOLD};1;49m✦\033[0;38:2:${GOLD};49m ${IMAGE_NAME^} \033[0m"
VERSION="$VERSION"
VERSION_ID="$VERSION_ID"
VERSION_CODENAME="Waxing Crescent"
ANSI_COLOR="38:2:${GOLD};1;49"
ANSI_COLOR_REVERSE="48;2;${GOLD//:/;};1;30"
LOGO="${IMAGE_NAME}"
HOME_URL="${HOME_URL}"
BUG_REPORT_URL="${HOME_URL}/issues"
SUPPORT_URL="${HOME_URL}/issues"
CPE_NAME="cpe:/o:${IMAGE_NAME}-dev:${IMAGE_NAME}"
DOCUMENTATION_URL="${HOME_URL}"
DEFAULT_HOSTNAME="${IMAGE_NAME}-????-????"
EOF

    tee /usr/lib/issue <<EOF
\e[0;38:2:${GOLD};1;49m▒\e[0m \e[0;38:2:${GOLD};1;49m✦\e[0;38:2:${GOLD};49m ${IMAGE_NAME^} \e[0m
\e[0;38:2:${GOLD};1;49m▒\e[0m Kernel \r on an \m (\l)

EOF
)
