#!/usr/bin/env python3
"""Exercise real TPM policy changes using only a disposable LUKS2 image/vTPM."""

import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile
import time


if os.geteuid() != 0:
    # No host privilege is acquired: all files and sockets belong to this user.
    os.execvp("unshare", ["unshare", "--user", "--map-root-user", sys.executable, __file__])

for binary in ("swtpm", "tpm2_pcrextend", "cryptsetup", "systemd-cryptenroll"):
    if not shutil.which(binary):
        raise SystemExit(f"Missing test prerequisite: {binary}")

# Image CI pipes this script to Python instead of mounting a source checkout.
# A test root also lets local checks exercise the same installed file layout.
if __file__ == "<stdin>":
    image_root = Path(os.environ.get("ASTRAL_TEST_ROOT", "/"))
    unlock_helper = image_root / "usr/bin/luks-tpm2-autounlock"
    secure_helper = image_root / "usr/libexec/astral/secure-tpm2"
else:
    repository = Path(__file__).resolve().parents[1]
    unlock_helper = repository / "mkosi.extra/usr/bin/luks-tpm2-autounlock"
    secure_helper = repository / "mkosi.extra/usr/libexec/astral/secure-tpm2"


with tempfile.TemporaryDirectory(prefix="astral-tpm-policy-") as directory:
    root = Path(directory)
    state = root / "state"
    state.mkdir()
    image = root / "test-luks.img"
    with image.open("xb") as stream:
        stream.truncate(64 * 1024 * 1024)
    assert stat.S_ISREG(image.stat().st_mode) and image.parent == root
    key = root / "recovery.key"
    key.write_bytes(b"disposable-test-recovery-credential")
    key.chmod(0o600)
    bad_key = root / "wrong.key"
    bad_key.write_bytes(b"wrong-disposable-test-credential")
    bad_key.chmod(0o600)
    socket = root / "swtpm.sock"
    device = f"swtpm:path={socket}"
    env = os.environ.copy()
    for name in ("PASSWORD", "NEWPASSWORD", "PIN", "NEWPIN", "CREDENTIALS_DIRECTORY", "SYSTEMD_TPM2_DEVICE"):
        env.pop(name, None)
    # Always name the private emulator explicitly; never auto-select a host TPM.
    env["TPM2TOOLS_TCTI"] = device
    server = None
    server_log = (root / "swtpm.log").open("w")

    def run(args, *, succeeds=True, recovery_input=None, test_env=None):
        stdin = {"stdin": subprocess.DEVNULL} if recovery_input is None else {"input": recovery_input}
        result = subprocess.run(args, env=env if test_env is None else test_env, **stdin,
                                text=True, capture_output=True, timeout=60)
        if succeeds and result.returncode != 0:
            raise RuntimeError(f"{Path(args[0]).name} failed: {result.stderr[-2000:]}")
        if not succeeds:
            assert result.returncode != 0, "An invalid unlock unexpectedly succeeded"
        return result

    def metadata():
        return json.loads(run(["cryptsetup", "luksDump", "--dump-json-metadata", str(image)]).stdout)

    def tpm_tokens():
        return [token for token in metadata()["tokens"].values() if token["type"] == "systemd-tpm2"]

    def enroll(pcrs, *, credential=key, unlock_tpm=False, succeeds=True, tpm_device=device, with_pin=False):
        unlock = f"--unlock-tpm2-device={device}" if unlock_tpm else f"--unlock-key-file={credential}"
        return run([
            "systemd-cryptenroll", unlock, f"--tpm2-device={tpm_device}",
            f"--tpm2-pcrs={pcrs}", f"--tpm2-with-pin={'yes' if with_pin else 'no'}", "--tpm2-public-key=",
            "--tpm2-pcrlock=", "--wipe-slot=tpm2", str(image),
        ], succeeds=succeeds)

    def recover():
        run(["cryptsetup", "open", "--type", "luks2", "--test-passphrase",
             "--disable-external-tokens", "--key-file=-", str(image)], recovery_input=key.read_text())

    def extend(pcr, digit):
        run(["tpm2_pcrextend", "-T", device, f"{pcr}:sha256=" + digit * 64])

    def start():
        global server
        server = subprocess.Popen([
            "swtpm", "socket", "--tpm2", "--tpmstate", f"dir={state}",
            "--server", f"type=unixio,path={socket}",
            "--ctrl", f"type=unixio,path={socket}.ctrl",
            "--flags", "not-need-init,startup-clear",
        ], env=env, stdout=server_log, stderr=server_log)
        for _ in range(100):
            if socket.exists():
                break
            assert server.poll() is None, "Software TPM exited during startup"
            time.sleep(0.05)
        assert socket.exists(), "Software TPM did not become ready"
        # Simulate initialized Secure Boot/shim measurements instead of zero PCRs.
        extend(7, "1")
        extend(14, "2")

    def stop():
        global server
        if server is not None:
            server.terminate()
            server.wait(timeout=10)
            server = None
        socket.unlink(missing_ok=True)
        Path(str(socket) + ".ctrl").unlink(missing_ok=True)

    try:
        start()
        # Low PBKDF cost is confined to this disposable test image.
        run(["cryptsetup", "luksFormat", "--batch-mode", "--type", "luks2",
             "--pbkdf", "pbkdf2", "--pbkdf-force-iterations", "1000",
             f"--key-file={key}", str(image)])
        # A marker in the data area must survive every header replacement.
        payload = os.urandom(4096)
        with image.open("r+b") as stream:
            stream.seek(20 * 1024 * 1024)
            stream.write(payload)
        password_slot = metadata()["keyslots"]["0"]
        enroll("")
        assert tpm_tokens()[0]["tpm2-pcrs"] == []
        extend(14, "3")
        enroll("", unlock_tpm=True)
        print("PASS: legacy unbound enrollment ignores changed PCR state", flush=True)

        # Run the guided wizard against this file and private emulator. Only its
        # UI, boot preflight, runtime directory, filesystem identity and sudo are
        # simulated. Every enrollment, recovery check and header operation is real.
        tools = root / "wizard-tools"
        tools.mkdir()
        recovery_directory = root / "recovery-media"
        recovery_directory.mkdir()
        real_enroll = shutil.which("systemd-cryptenroll")
        stub = tools / "stub"
        stub.write_text('''#!/usr/bin/python3
import json, os, sys, tempfile
from pathlib import Path
name = Path(sys.argv[0]).name
args = sys.argv[1:]
if name == "sudo":
    if args == ["-v"]: sys.exit(0)
    os.execvp(args[0], args)
elif name == "gum":
    counter = Path(os.environ["WIZARD_COUNTER"])
    i = int(counter.read_text()) if counter.exists() else 0
    counter.write_text(str(i + 1))
    answer = json.loads(os.environ["WIZARD_ANSWERS"])[i]
    if isinstance(answer, str): print(answer)
    else: sys.exit(answer)
elif name == "mokutil": print("SecureBoot enabled")
elif name == "systemd-analyze": print(json.dumps([{"nr": 7, "sha256": "1"*64}, {"nr": 14, "sha256": "2"*64}]))
elif name == "systemd-ask-password": sys.stdout.write(Path(os.environ["WIZARD_KEY"]).read_text())
elif name == "findmnt":
    print("ext4" if args[-1] == "FSTYPE" else ("system" if args[args.index("-T") + 1] == "/var" else "external"))
elif name == "mktemp":
    if args == ["-d", "/run/astral-tpm2.XXXXXXXX"]:
        print(tempfile.mkdtemp(prefix="private-header-", dir=os.environ["WIZARD_TMP"]))
    else:
        os.execv("/usr/bin/mktemp", ["mktemp", *args])
elif name == "systemd-cryptenroll":
    if Path(args[-1]).name == "candidate":
        assert Path(args[-1]).parent.stat().st_mode & 0o777 == 0o700
    args = [a.replace("=auto", "=" + os.environ["WIZARD_TPM"]) if a.startswith(("--tpm2-device=", "--unlock-tpm2-device=")) else a for a in args]
    args += ["--tpm2-public-key=", "--tpm2-pcrlock="]
    if any(a.startswith("--tpm2-device=") for a in args):
        args += ["--unlock-key-file=" + os.environ.get("WIZARD_ENROLL_KEY", os.environ["WIZARD_KEY"])]
    os.execv(os.environ["WIZARD_ENROLL"], [os.environ["WIZARD_ENROLL"], *args])
else: raise AssertionError(name)
''')
        stub.chmod(0o755)
        for name in ("sudo", "gum", "mokutil", "systemd-analyze", "systemd-ask-password", "findmnt", "mktemp", "systemd-cryptenroll"):
            (tools / name).symlink_to(stub)
        (tools / "luks-tpm2-autounlock").symlink_to(unlock_helper)
        wizard_env = env | {
            "PATH": str(tools) + ":" + env["PATH"],
            "WIZARD_COUNTER": str(root / "wizard-counter"),
            "WIZARD_ANSWERS": json.dumps([0, "Create a recovery key using the existing TPM enrollment",
                                          str(recovery_directory), 0, 0,
                                          "Enable or replace TPM2 enrollment", 0, "No PIN"]),
            "WIZARD_KEY": str(key), "WIZARD_TPM": device, "WIZARD_ENROLL": real_enroll,
            "WIZARD_TMP": str(root),
        }
        run(["bash", str(secure_helper),
             "--apply", "--device", str(image)], test_env=wizard_env)
        assert len(tpm_tokens()) == 1 and tpm_tokens()[0]["tpm2-pcrs"] == [7, 14]
        assert any(t["type"] == "systemd-recovery" for t in metadata()["tokens"].values())
        assert metadata()["keyslots"]["0"] == password_slot
        recover()
        backup_directory, = recovery_directory.iterdir()
        assert stat.S_IMODE(backup_directory.stat().st_mode) == 0o700
        for filename in ("header-before.img", "header-with-recovery.img", "header-secured.img"):
            assert stat.S_IMODE((backup_directory / filename).stat().st_mode) == 0o600
        restored = root / "header-recovery-test.img"
        with restored.open("xb") as stream:
            stream.truncate(64 * 1024 * 1024)
        run(["cryptsetup", "luksHeaderRestore", "--batch-mode", str(restored),
             "--header-backup-file", str(backup_directory / "header-secured.img")])
        run(["cryptsetup", "open", "--type", "luks2", "--test-passphrase",
             "--disable-external-tokens", "--key-file=-", str(restored)], recovery_input=key.read_text())
        print("PASS: guided setup creates recovery, migrates policy, and produces a restorable private header backup", flush=True)

        def replace(*, credential=key, tpm_device=device, with_pin=False, succeeds=True):
            counter = root / "replace-counter"
            counter.unlink(missing_ok=True)
            test_env = wizard_env | {
                "WIZARD_COUNTER": str(counter),
                "WIZARD_ANSWERS": json.dumps(["Enable or replace TPM2 enrollment", 0,
                                              "Require a PIN" if with_pin else "No PIN"]),
                "WIZARD_ENROLL_KEY": str(credential), "WIZARD_TPM": tpm_device,
            }
            if "NEWPIN" in env:
                test_env["NEWPIN"] = env["NEWPIN"]
            result = run(["bash", str(unlock_helper),
                          "--device", str(image)], succeeds=succeeds, test_env=test_env)
            assert not list(root.glob("private-header-*")), "Temporary headers were not removed"
            return result

        stop()
        start()
        recover()
        enroll("7+14")
        assert len(tpm_tokens()) == 1 and tpm_tokens()[0]["tpm2-pcrs"] == [7, 14]
        assert metadata()["keyslots"]["0"] == password_slot
        enroll("7+14", unlock_tpm=True)
        print("PASS: explicit migration replaces the legacy TPM slot and preserves recovery", flush=True)

        # A new emulator state models a firmware TPM clear without changing PCRs.
        stale = tpm_tokens()[0]
        independent_slots = {s: v for s, v in metadata()["keyslots"].items() if s not in stale["keyslots"]}
        stop()
        shutil.rmtree(state)
        state.mkdir()
        start()
        enroll("7+14", unlock_tpm=True, succeeds=False)
        replace()
        assert len(tpm_tokens()) == 1 and tpm_tokens()[0]["tpm2-pcrs"] == [7, 14]
        assert tpm_tokens()[0]["tpm2-blob"] != stale["tpm2-blob"]
        assert all(metadata()["keyslots"][s] == v for s, v in independent_slots.items())
        enroll("7+14", unlock_tpm=True)
        recover()
        print("PASS: the helper repairs a cleared TPM with unchanged PCRs and retains independent recovery slots", flush=True)

        previous = metadata()
        with image.open("rb") as stream:
            previous_header = stream.read(16 * 1024 * 1024)
        replace(credential=bad_key, succeeds=False)
        assert metadata() == previous
        with image.open("rb") as stream:
            assert stream.read(16 * 1024 * 1024) == previous_header
        enroll("7+14", unlock_tpm=True)
        print("PASS: failed authorization preserves the existing enrollment", flush=True)

        previous = metadata()
        replace(tpm_device=f"swtpm:path={root / 'unavailable.sock'}", succeeds=False)
        assert metadata() == previous
        with image.open("rb") as stream:
            assert stream.read(16 * 1024 * 1024) == previous_header
        enroll("7+14", unlock_tpm=True)
        recover()
        print("PASS: failed new TPM enrollment preserves the working TPM and recovery slots", flush=True)

        for pcr in (7, 14):
            previous = metadata()
            extend(pcr, "4")
            result = enroll("7+14", unlock_tpm=True, succeeds=False)
            assert any(word in result.stderr.lower() for word in ("pcr", "policy")), result.stderr
            assert metadata() == previous
            recover()
            stop()
            start()
            enroll("7+14", unlock_tpm=True)
            recover()
            print(f"PASS: PCR {pcr} change rejects TPM unlock, recovery works, restored state unlocks after vTPM restart", flush=True)

        # These fixed credentials belong only to the private emulator fixture.
        env["NEWPIN"] = "disposable-vtpm-pin"
        replace(with_pin=True)
        assert tpm_tokens()[0]["tpm2-pin"] is True
        env["PIN"] = env["NEWPIN"]
        enroll("7+14", unlock_tpm=True, with_pin=True)
        recover()
        assert metadata()["keyslots"]["0"] == password_slot
        env.pop("PIN")
        env.pop("NEWPIN")
        print("PASS: PIN-protected TPM enrollment unlocks and retains independent recovery", flush=True)

        run(["systemd-cryptenroll", "--wipe-slot=tpm2", str(image)])
        assert tpm_tokens() == []
        recover()
        assert metadata()["keyslots"]["0"] == password_slot
        print("PASS: disabling TPM enrollment retains the independent recovery credential", flush=True)

        replace()
        assert len(tpm_tokens()) == 1 and tpm_tokens()[0]["tpm2-pcrs"] == [7, 14]
        enroll("7+14", unlock_tpm=True)
        recover()
        print("PASS: first enrollment without an existing TPM token retains independent recovery", flush=True)
        with image.open("rb") as stream:
            stream.seek(20 * 1024 * 1024)
            assert stream.read(len(payload)) == payload
        print("PASS: header replacements leave the encrypted data area unchanged", flush=True)
    finally:
        stop()
        server_log.close()
